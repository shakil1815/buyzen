# SQLite database used by Prisma
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies (change in production)
AUTH_SECRET="change-me-to-a-long-random-string"

# Public URL of the deployment (used for metadata, sitemap and Stripe redirects)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Exchange rate used to display USD prices in Bangladeshi Taka (৳)
USD_TO_BDT_RATE="120"

# Optional: enables the hosted AI assistant.
# Without it the built-in catalog-aware assistant is used instead.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Optional: enables Stripe Checkout instead of the built-in card form.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
