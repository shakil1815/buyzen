{
  "name": "ecommerce-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "node prisma/seed.mts",
    "db:studio": "prisma studio",
    "setup": "prisma migrate deploy && prisma generate && node prisma/seed.mts",
    "e2e": "node scripts/e2e.mjs",
    "e2e:account": "node scripts/e2e-account.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "verify": "npm run typecheck && npm run lint && npm run build",
    "e2e:admin": "node scripts/e2e-admin.mjs",
    "screenshots:mobile": "node scripts/screenshots-mobile.mjs",
    "e2e:i18n": "node scripts/e2e-i18n.mjs",
    "screenshots:i18n": "node scripts/screenshots-i18n.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.mts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.17",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright-core": "^1.65.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
